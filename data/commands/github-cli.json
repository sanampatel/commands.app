    "id": "gh-api",
    "name": "gh api",
    "description": "Make an authenticated request to the GitHub REST or GraphQL API.",
    "category": "Advanced",
    "technologyId": "github-cli",
    "flags": [
      {
        "flag": "-X, --method <method>",
        "description": "HTTP method"
      },
      {
        "flag": "-f, --raw-field <key=value>",
        "description": "Add a string parameter"
      },
      {
        "flag": "-F, --field <key=value>",
        "description": "Add a typed parameter (@file reads a file)"
      },
      {
        "flag": "--paginate",
        "description": "Fetch all pages"
      },
      {
        "flag": "-q, --jq <expr>",
        "description": "Filter output with jq syntax"
      }
    ],
    "examples": [
      {
        "command": "gh api repos/{owner}/{repo}/pulls --jq '.[].title'",
        "description": "List PR titles for the current repo"
      },
      {
        "command": "gh api user/repos --paginate --jq '.[].full_name'",
        "description": "List all your repos"
      },
      {
        "command": "gh api -X POST repos/{owner}/{repo}/issues -f title=\"Bug\" -f body=\"Details\"",
        "description": "Create an issue via REST"
      },
      {
        "command": "gh api graphql -f query='query { viewer { login } }'",
        "description": "Run a GraphQL query"
      }
    ],
    "notes": [
      "{owner} and {repo} placeholders are filled from the current repository"
    ],
    "relatedCommands": [
      "gh-search"
    ]
  },
