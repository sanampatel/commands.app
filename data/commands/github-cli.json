[
  {
    "id": "gh-auth-login",
    "name": "gh auth login",
    "description": "Authenticate gh with a GitHub host.",
    "category": "Auth & Setup",
    "technologyId": "github-cli",
    "flags": [
      {
        "flag": "-h, --hostname <host>",
        "description": "GitHub host, e.g. github.example.com for Enterprise"
      },
      {
        "flag": "-w, --web",
        "description": "Authenticate via the browser"
      },
      {
        "flag": "--with-token",
        "description": "Read a token from stdin"
      },
      {
        "flag": "-s, --scopes <scopes>",
        "description": "Request additional OAuth scopes"
      },
      {
        "flag": "-p, --git-protocol <https|ssh>",
        "description": "Protocol for git operations"
      }
    ],
    "examples": [
      {
        "command": "gh auth login",
        "description": "Interactive login"
      },
      {
        "command": "gh auth login --web --git-protocol ssh",
        "description": "Browser login using SSH for git"
      },
      {
        "command": "gh auth login --with-token < token.txt",
        "description": "Login with a token from a file"
      },
      {
        "command": "gh auth refresh -s read:project",
        "description": "Add a missing scope to an existing login"
      }
    ],
    "notes": [
      "In CI, set GH_TOKEN instead of logging in"
    ],
    "relatedCommands": [
      "gh-auth-status"
    ]
  },
  {
    "id": "gh-auth-status",
    "name": "gh auth status",
    "description": "Show authentication status for all configured hosts.",
    "category": "Auth & Setup",
    "technologyId": "github-cli",
    "flags": [
      {
        "flag": "-t, --show-token",
        "description": "Display the auth token"
      },
      {
        "flag": "-a, --active",
        "description": "Only show the active account"
      }
    ],
    "examples": [
      {
        "command": "gh auth status",
        "description": "See which accounts are logged in"
      },
      {
        "command": "gh auth switch",
        "description": "Switch the active account"
      },
      {
        "command": "gh auth token",
        "description": "Print the token (e.g. to pipe into another tool)"
      }
    ],
    "notes": [
      "Avoid --show-token and gh auth token output in shared logs"
    ],
    "relatedCommands": [
      "gh-auth-login"
    ]
  },
  {
    "id": "gh-repo-clone",
    "name": "gh repo clone",
    "description": "Clone a GitHub repository locally.",
    "category": "Repositories",
    "technologyId": "github-cli",
    "examples": [
      {
        "command": "gh repo clone owner/repo",
        "description": "Clone by owner/name"
      },
      {
        "command": "gh repo clone owner/repo my-dir -- --depth=1",
        "description": "Shallow clone into a custom directory"
      },
      {
        "command": "gh repo clone repo",
        "description": "Clone one of your own repos without the owner prefix"
      }
    ],
    "notes": [
      "Cloning a fork automatically adds the parent repo as the upstream remote"
    ],
    "relatedCommands": [
      "gh-repo-fork",
      "gh-repo-create"
    ]
  },
