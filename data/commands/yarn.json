    ],
    "relatedCommands": [
      "yarn-unlink"
    ]
  },
  {
    "id": "yarn-workspaces",
    "name": "yarn workspaces",
    "description": "Manage monorepo workspaces",
    "category": "Monorepo",
    "technologyId": "yarn",
    "examples": [
      {
        "command": "yarn workspaces list",
        "description": "Yarn 2+: list workspaces"
      },
      {
        "command": "yarn workspace web add react",
        "description": "Add a dependency to one workspace"
      },
      {
        "command": "yarn workspace api run build",
        "description": "Run a script in one workspace"
      },
      {
        "command": "yarn workspaces info",
        "description": "Show workspace tree"
      },
      {
        "command": "yarn workspace package-name add dependency",
        "description": "Add dependency to specific workspace"
      }
    ],
    "notes": [
      "Requires workspaces in package.json",
      "'yarn workspaces info' is Yarn Classic only; Yarn 2+ uses 'yarn workspaces list'"
    ],
    "relatedCommands": [
      "yarn-workspaces-foreach"
    ]
  },
  {
    "id": "yarn-workspaces-foreach",
    "name": "yarn workspaces foreach",
    "description": "Run a command in every workspace (Yarn 2+)",
    "category": "Monorepo",
    "technologyId": "yarn",
    "flags": [
      {
        "flag": "-A, --all",
        "description": "Run in all workspaces"
      },
      {
        "flag": "-p, --parallel",
        "description": "Run in parallel"
      },
      {
        "flag": "-t, --topological",
        "description": "Run dependencies before dependents"
      },
      {
        "flag": "--include / --exclude <glob>",
        "description": "Filter workspaces by name"
      }
    ],
    "examples": [
      {
        "command": "yarn workspaces foreach -A run build",
        "description": "Build every workspace"
      },
      {
        "command": "yarn workspaces foreach -Apt run build",
        "description": "Build in parallel, respecting dependency order"
      },
      {
        "command": "yarn workspaces foreach -A --include \"@acme/*\" run test",
        "description": "Test only matching workspaces"
      }
    ],
    "notes": [
      "Built into Yarn 4 (Yarn 2-3 needed the workspace-tools plugin)"
    ],
    "relatedCommands": [
      "yarn-workspaces"
    ]
  },
