        "command": "yarn link ~/code/my-monorepo --all",
        "description": "Yarn 2+: link every workspace of another project"
      },
      {
        "command": "yarn unlink --all",
        "description": "Yarn 2+: remove all links"
      },
      {
        "command": "yarn link",
        "description": "Yarn Classic: register the current package as linkable"
      },
      {
        "command": "yarn link package-name",
        "description": "Yarn Classic: use a registered package"
      }
    ],
    "notes": [
      "Yarn Classic uses global link registration (yarn link, then yarn link <name>); Yarn 2+ links by path and writes a resolutions entry"
    ],
    "relatedCommands": [
      "yarn-unlink"
    ]
  },
  {
