  {
    "id": "yarn-init",
    "name": "yarn init",
    "description": "Create a package.json file",
    "category": "Project Setup",
    "technologyId": "yarn",
    "flags": [
      {
        "flag": "-p, --private",
        "description": "Yarn 2+: create a private package"
      },
      {
        "flag": "-w, --workspace",
        "description": "Yarn 2+: create a private workspace root with a packages/ folder"
      },
      {
        "flag": "-y",
        "description": "Yarn Classic: skip questions, use defaults"
      }
    ],
    "examples": [
      {
        "command": "yarn init",
        "description": "Initialize project (Yarn 2+ creates package.json without prompts)"
      },
      {
        "command": "yarn init -w",
        "description": "Yarn 2+: initialize a monorepo root"
      },
      {
        "command": "yarn init -y",
        "description": "Yarn Classic: initialize with defaults"
      }
    ],
    "notes": [
      "Yarn 2+: yarn init also creates .editorconfig and initializes a git repository",
      "yarn init -2 (Classic) bootstraps a project with the latest Berry release"
    ],
    "relatedCommands": []
  },
