  {
    "id": "yarn-config",
    "name": "yarn config",
    "description": "Manage yarn configuration",
    "category": "Configuration",
    "technologyId": "yarn",
    "examples": [
      {
        "command": "yarn config",
        "description": "Yarn 2+: show all settings"
      },
      {
