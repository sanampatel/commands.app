    "id": "yarn-dlx",
    "name": "yarn dlx",
    "description": "Run a package binary without installing (like npx)",
    "category": "Execution",
    "technologyId": "yarn",
    "examples": [
      {
        "command": "yarn dlx create-react-app my-app",
        "description": "Run create-react-app without installing"
      },
      {
        "command": "yarn dlx eslint --version",
        "description": "Run eslint without installing"
      },
      {
        "command": "yarn dlx create-vite my-app",
        "description": "Scaffold a project with a one-off package"
      }
    ],
    "notes": [
      "Available in Yarn 2+ (Berry)",
      "Yarn 2+ only; the Classic equivalent is npx",
      "Use -p to add extra packages to the temporary environment"
    ],
    "relatedCommands": [
      "yarn-run"
    ]
  }
]
