        "description": "List outdated packages"
      }
    ],
    "notes": [
      "DEPRECATED in modern Yarn: Classic (1.x) only, removed in Yarn 2+ (Berry, current is 4.x). Use 'yarn upgrade-interactive', which shows outdated packages in Yarn 4."
    ],
    "relatedCommands": [
      "yarn-upgrade",
      "yarn-upgrade-interactive"
    ]
  },
  {
    "id": "yarn-upgrade-interactive",
    "name": "yarn upgrade-interactive",
    "description": "Interactively upgrade packages",
    "category": "Package Management",
    "technologyId": "yarn",
    "flags": [
      {
        "flag": "--latest",
        "description": "Yarn Classic only: ignore ranges and offer latest versions (Berry always shows latest)"
      }
    ],
    "examples": [
      {
        "command": "yarn upgrade-interactive",
        "description": "Choose packages to upgrade"
      },
      {
        "command": "yarn upgrade-interactive --latest",
        "description": "Upgrade to latest versions"
      }
    ],
    "notes": [
      "Built into Yarn 4; in Yarn 2-3 it needed the interactive-tools plugin"
    ],
    "relatedCommands": [
      "yarn-up"
    ]
  },
  {
    "id": "yarn-up",
    "name": "yarn up",
    "description": "Upgrade dependencies across all workspaces (Yarn 2+)",
    "category": "Package Management",
    "technologyId": "yarn",
    "flags": [
      {
        "flag": "-i, --interactive",
        "description": "Ask which version to use when there are choices"
      },
      {
        "flag": "-R, --recursive",
        "description": "Upgrade a transitive dependency everywhere in the tree"
      },
      {
        "flag": "-E, --exact",
        "description": "Pin the exact version"
      }
    ],
    "examples": [
      {
        "command": "yarn up react react-dom",
        "description": "Upgrade packages to the latest version"
      },
      {
        "command": "yarn up typescript@~5.9",
        "description": "Upgrade to a specific range"
      },
      {
        "command": "yarn up \"@types/*\"",
        "description": "Upgrade all packages matching a glob"
      },
      {
        "command": "yarn up -R lodash",
        "description": "Refresh a transitive dependency's resolution"
      }
    ],
    "notes": [
      "Replaces Yarn Classic's 'yarn upgrade'"
    ],
    "relatedCommands": [
      "yarn-upgrade-interactive",
      "yarn-dedupe"
    ]
  },
  {
    "id": "yarn-link",
