  {
    "id": "yarn-set-version",
    "name": "yarn set version",
    "description": "Pin the Yarn version used by the project",
    "category": "Configuration",
    "technologyId": "yarn",
    "examples": [
      {
        "command": "yarn set version stable",
        "description": "Use the latest stable Yarn (writes packageManager in package.json)"
      },
      {
        "command": "yarn set version 4.9.2",
        "description": "Pin an exact release"
      },
      {
        "command": "yarn set version classic",
        "description": "Switch back to Yarn 1.x"
      }
    ],
    "notes": [
      "Replaces Yarn Classic's 'yarn policies set-version'",
      "Commit package.json (packageManager) and any .yarn/releases file it creates"
