  {
    "id": "yarn-corepack-enable",
    "name": "corepack enable",
    "description": "Install Yarn via Corepack so each project uses its pinned version",
    "category": "Configuration",
    "technologyId": "yarn",
    "examples": [
      {
        "command": "corepack enable",
        "description": "Enable yarn/pnpm shims that respect package.json's packageManager"
      },
      {
        "command": "npm install -g corepack",
        "description": "Install Corepack (Node.js 25+ no longer bundles it)"
      },
      {
        "command": "corepack use yarn@stable",
        "description": "Pin the latest stable Yarn in package.json"
      }
    ],
    "notes": [
      "Corepack is the recommended way to install Yarn 2+; installing yarn from npm gives you Classic 1.x"
    ],
    "relatedCommands": [
      "yarn-set-version"
    ]
  },
