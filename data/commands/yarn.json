[
  {
    "id": "yarn-install",
    "name": "yarn install",
    "description": "Install all dependencies from package.json",
    "category": "Package Management",
    "technologyId": "yarn",
    "flags": [
      {
        "flag": "--immutable",
        "description": "Yarn 2+: fail if yarn.lock would change (use in CI)"
      },
      {
        "flag": "--immutable-cache",
        "description": "Yarn 2+: also fail if the cache would change"
      },
      {
        "flag": "--mode=skip-build",
        "description": "Yarn 2+: install without running build scripts"
      },
      {
        "flag": "--frozen-lockfile",
        "description": "Yarn Classic: fail if yarn.lock needs updating (Berry: --immutable)"
      },
      {
        "flag": "--production",
        "description": "Yarn Classic only: skip devDependencies"
      }
    ],
    "examples": [
      {
        "command": "yarn install",
        "description": "Install all dependencies"
      },
      {
        "command": "yarn",
        "description": "Shorthand for yarn install"
      },
      {
        "command": "yarn install --immutable",
        "description": "CI install that fails on lockfile drift (Yarn 2+)"
      },
      {
        "command": "yarn workspaces focus --production",
        "description": "Yarn 2+: production-only install (needs a workspace root)"
      }
    ],
    "notes": [
      "Check your version with yarn --version: 1.x is Classic, 2.x-4.x is Berry",
      "--frozen-lockfile is still accepted by Berry as a deprecated alias of --immutable",
      "Yarn 4.14+: third-party build scripts no longer run by default (enableScripts: false); allow a package with dependenciesMeta.<pkg>.built: true in package.json",
      "Yarn 4.15+: versions published less than 1 day ago are not installed by default (npmMinimalAgeGate: 1d); exempt packages with npmPreapprovedPackages"
    ],
    "relatedCommands": [
      "yarn-add",
      "yarn-rebuild",
      "yarn-config"
    ]
  },
  {
    "id": "yarn-add",
    "name": "yarn add",
    "description": "Add a package to dependencies",
    "category": "Package Management",
    "technologyId": "yarn",
    "flags": [
      {
        "flag": "-D, --dev",
        "description": "Add to devDependencies"
      },
      {
        "flag": "-E, --exact",
        "description": "Pin the exact version"
      },
      {
        "flag": "-P, --peer",
        "description": "Add as a peerDependency"
      },
      {
        "flag": "-O, --optional",
        "description": "Add as an optionalDependency"
      },
      {
        "flag": "--no-time-gate",
        "description": "Yarn 4.15+: skip the minimum release age check for this command"
      },
      {
        "flag": "-g",
        "description": "Yarn Classic only: install globally (use yarn dlx in Berry)"
      }
    ],
    "examples": [
      {
        "command": "yarn add express",
        "description": "Add package"
      },
      {
        "command": "yarn add -D typescript",
        "description": "Add dev dependency"
      },
      {
        "command": "yarn add react@^19",
        "description": "Add with a version range"
      },
      {
        "command": "yarn add -E prettier",
        "description": "Pin an exact version"
      }
    ],
    "relatedCommands": [
      "yarn-remove"
    ]
  },
  {
    "id": "yarn-remove",
    "name": "yarn remove",
    "description": "Remove a package",
    "category": "Package Management",
    "technologyId": "yarn",
    "examples": [
      {
        "command": "yarn remove express",
        "description": "Remove package"
      }
    ],
    "relatedCommands": [
      "yarn-add"
    ]
  },
  {
    "id": "yarn-upgrade",
