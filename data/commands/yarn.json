  {
    "id": "yarn-cache",
    "name": "yarn cache",
    "description": "Manage yarn cache",
    "category": "Maintenance",
    "technologyId": "yarn",
    "examples": [
      {
        "command": "yarn cache clean",
        "description": "Clear the cache"
      },
      {
        "command": "yarn cache clean --all",
        "description": "Yarn 2+: clear both the global cache and the project's local cache"
      },
      {
        "command": "yarn cache clean --mirror",
        "description": "Yarn 2+: clear only the global cache"
      },
      {
        "command": "yarn cache dir",
        "description": "Yarn Classic: show cache directory"
      },
      {
        "command": "yarn cache list",
        "description": "Yarn Classic: list cached packages"
      }
    ],
    "notes": [
      "'cache dir' and 'cache list' are Yarn Classic only",
      "Yarn 2+ stores the cache in .yarn/cache (or a global folder when enableGlobalCache is true)"
    ],
    "relatedCommands": []
  },
  {
