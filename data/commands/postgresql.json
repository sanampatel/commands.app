  {
    "id": "pg-explain-analyze",
    "name": "EXPLAIN ANALYZE",
    "description": "Run a query and show its actual execution plan, row counts and timings",
    "category": "Performance",
    "technologyId": "postgresql",
    "flags": [
      {
        "flag": "BUFFERS",
        "description": "Show shared buffer hits/reads (included by default with ANALYZE in PostgreSQL 18+)"
      },
      {
        "flag": "VERBOSE",
        "description": "Show output columns and more detail"
      },
      {
        "flag": "FORMAT JSON",
        "description": "Machine-readable output for plan visualizers"
      }
    ],
    "examples": [
      {
        "command": "EXPLAIN ANALYZE SELECT * FROM orders WHERE customer_id = 42;",
        "description": "Show the real plan and timing"
      },
      {
        "command": "EXPLAIN (ANALYZE, BUFFERS) SELECT * FROM orders WHERE created_at > now() - interval '1 day';",
        "description": "Include buffer usage (PostgreSQL 17 and earlier)"
      },
      {
        "command": "EXPLAIN SELECT * FROM orders WHERE customer_id = 42;",
        "description": "Estimated plan only, without running the query"
      },
      {
        "command": "BEGIN; EXPLAIN ANALYZE DELETE FROM sessions WHERE expires_at < now(); ROLLBACK;",
        "description": "Analyze a write query without keeping its changes"
      }
    ],
    "notes": [
      "WARNING: ANALYZE actually executes the statement; wrap INSERT/UPDATE/DELETE in a transaction and roll back",
      "Compare estimated vs actual rows to spot stale statistics"
    ],
    "relatedCommands": [
      "pg-vacuum-analyze",
      "psql-timing",
      "pg-stat-activity"
    ]
  },
  {
    "id": "pg-vacuum-analyze",
    "name": "VACUUM ANALYZE",
    "description": "Reclaim dead-row space and refresh planner statistics from SQL",
    "category": "Performance",
    "technologyId": "postgresql",
    "examples": [
      {
        "command": "VACUUM ANALYZE orders;",
        "description": "Vacuum and analyze one table"
      },
      {
        "command": "ANALYZE;",
        "description": "Refresh statistics for the whole database (fast, no vacuum)"
      },
      {
        "command": "VACUUM (VERBOSE, ANALYZE) orders;",
        "description": "Show detailed progress"
      },
      {
        "command": "SELECT relname, last_autovacuum, last_autoanalyze FROM pg_stat_user_tables ORDER BY relname;",
        "description": "Check when autovacuum last ran"
      }
    ],
    "notes": [
      "Plain VACUUM doesn't block reads or writes; VACUUM FULL rewrites the table under an exclusive lock",
      "Can't run inside a transaction block"
    ],
    "relatedCommands": [
      "pg-vacuum",
      "pg-explain-analyze"
    ]
  },
  {
    "id": "pg-stat-activity",
    "name": "pg_stat_activity",
    "description": "Show current connections and running queries, and cancel or terminate them",
    "category": "Performance",
    "technologyId": "postgresql",
    "examples": [
      {
        "command": "SELECT pid, usename, state, now() - query_start AS runtime, query FROM pg_stat_activity WHERE state <> 'idle' ORDER BY runtime DESC;",
        "description": "Show active queries, longest first"
      },
      {
        "command": "SELECT pg_cancel_backend(12345);",
        "description": "Cancel a running query by pid"
      },
      {
        "command": "SELECT pg_terminate_backend(12345);",
        "description": "Terminate a connection by pid"
      }
    ],
    "notes": [
      "WARNING: pg_terminate_backend kills the session and rolls back its open transaction; try pg_cancel_backend first"
    ],
    "relatedCommands": [
