  {
    "id": "pg-vacuum",
    "name": "vacuumdb",
    "description": "Garbage-collect and analyze PostgreSQL database",
    "category": "Maintenance",
    "technologyId": "postgresql",
    "flags": [
      {
        "flag": "-a",
        "description": "Vacuum all databases"
      },
      {
        "flag": "-z",
        "description": "Also update optimizer statistics"
      },
      {
        "flag": "-f",
        "description": "Full vacuum (reclaims more space)"
      },
      {
        "flag": "-j",
        "description": "Number of parallel jobs"
      }
    ],
    "examples": [
      {
        "command": "vacuumdb mydb",
        "description": "Vacuum specific database"
      },
      {
        "command": "vacuumdb -a -z",
        "description": "Vacuum all databases with analyze"
      },
      {
        "command": "vacuumdb -f mydb",
        "description": "Full vacuum for maximum space recovery"
      }
    ],
    "notes": [
      "Regular vacuum is non-blocking",
      "Full vacuum requires exclusive lock",
      "WARNING: -f (VACUUM FULL) rewrites tables under an ACCESS EXCLUSIVE lock, blocking reads and writes",
      "Autovacuum normally handles routine vacuuming; run vacuumdb -z after big imports or a pg_upgrade"
    ],
    "relatedCommands": [
      "pg-reindex"
    ]
  },
  {
