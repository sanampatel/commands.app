[
  {
    "id": "psql",
    "name": "psql",
    "description": "PostgreSQL interactive terminal",
    "category": "Connection",
    "technologyId": "postgresql",
    "flags": [
      {
        "flag": "-h",
        "description": "Specify database server host"
      },
      {
        "flag": "-p",
        "description": "Specify database server port"
      },
      {
        "flag": "-U",
        "description": "Connect as specified database user"
      },
      {
        "flag": "-d",
        "description": "Specify database name to connect to"
      },
      {
        "flag": "-c",
        "description": "Execute a single command and exit"
      },
      {
        "flag": "-f",
        "description": "Execute commands from a file"
      },
      {
        "flag": "-X",
        "description": "Don't read ~/.psqlrc (predictable output in scripts)"
      },
      {
        "flag": "-v ON_ERROR_STOP=1",
        "description": "Stop a script at the first error"
      }
    ],
    "examples": [
      {
        "command": "psql -U postgres",
        "description": "Connect as postgres user"
      },
      {
        "command": "psql -h localhost -U myuser -d mydb",
        "description": "Connect to specific database on localhost"
      },
      {
        "command": "psql -c 'SELECT version();'",
        "description": "Execute single query and exit"
      },
      {
        "command": "psql -f script.sql mydb",
        "description": "Run SQL script on database"
      },
      {
        "command": "psql \"postgresql://user@db.example.com:5432/mydb?sslmode=require\"",
        "description": "Connect with a connection URI"
      },
      {
        "command": "psql -X -v ON_ERROR_STOP=1 -d mydb -f migrate.sql",
        "description": "Run a script safely, stopping on the first error"
      }
    ],
    "notes": [
      "Use \\q to quit psql",
      "Use \\? for help on psql commands",
      "Use ~/.pgpass or the PGPASSWORD env var rather than typing passwords in commands"
    ],
    "relatedCommands": [
      "pg-dump",
      "pg-restore",
      "createdb",
      "pg-isready"
    ]
  },
  {
    "id": "pg-isready",
    "name": "pg_isready",
    "description": "Check whether a PostgreSQL server is accepting connections",
    "category": "Connection",
    "technologyId": "postgresql",
    "flags": [
      {
        "flag": "-h",
        "description": "Host"
      },
      {
        "flag": "-p",
        "description": "Port"
      },
      {
        "flag": "-d",
        "description": "Database name"
      },
      {
        "flag": "-t",
        "description": "Seconds to wait (default 3)"
      },
      {
        "flag": "-q",
        "description": "Quiet: only set the exit code"
      }
    ],
    "examples": [
      {
        "command": "pg_isready -h localhost -p 5432",
        "description": "Check a server",
        "output": "localhost:5432 - accepting connections"
      },
      {
        "command": "until pg_isready -h db -q; do sleep 1; done",
        "description": "Wait for a database in a startup script or CI"
      }
    ],
    "notes": [
      "Exit codes: 0 accepting, 1 rejecting (e.g. starting up), 2 no response, 3 no attempt made (bad parameters)",
      "Doesn't check credentials; it only tests that the server accepts connections"
    ],
    "relatedCommands": [
      "psql",
      "pg-ctl"
    ]
  },
  {
    "id": "createdb",
    "name": "createdb",
    "description": "Create a new PostgreSQL database",
    "category": "Database Management",
    "technologyId": "postgresql",
    "flags": [
      {
        "flag": "-O",
        "description": "Specify the owner of the new database"
      },
      {
        "flag": "-T",
        "description": "Specify template database to copy"
      },
      {
        "flag": "-E",
        "description": "Specify character encoding"
      }
    ],
    "examples": [
      {
        "command": "createdb myapp",
        "description": "Create database named myapp"
      },
      {
        "command": "createdb -O myuser myapp",
        "description": "Create database with specific owner"
      },
      {
        "command": "createdb -E UTF8 myapp",
        "description": "Create database with UTF-8 encoding"
      }
    ],
    "notes": [
      "Requires appropriate PostgreSQL privileges"
    ],
    "relatedCommands": [
      "dropdb",
      "psql"
    ]
  },
  {
    "id": "dropdb",
    "name": "dropdb",
    "description": "Remove a PostgreSQL database",
    "category": "Database Management",
    "technologyId": "postgresql",
    "flags": [
      {
        "flag": "-i",
        "description": "Prompt before deleting"
      },
      {
        "flag": "--if-exists",
        "description": "Don't error if database doesn't exist"
      },
      {
        "flag": "--force",
        "description": "Terminate existing connections first (PostgreSQL 13+)"
      }
    ],
    "examples": [
      {
        "command": "dropdb myapp",
        "description": "Drop database named myapp"
      },
      {
        "command": "dropdb -i myapp",
        "description": "Drop with confirmation prompt"
      },
      {
        "command": "dropdb --if-exists myapp",
        "description": "Drop only if exists"
      }
    ],
    "notes": [
      "Cannot drop a database you are connected to",
      "This action is irreversible",
      "WARNING: permanently deletes the database and all its data; take a pg_dump first",
      "Use --force (PostgreSQL 13+) to terminate existing connections"
    ],
    "relatedCommands": [
      "createdb",
      "psql"
    ]
  },
  {
    "id": "pg-dump",
    "name": "pg_dump",
    "description": "Backup a PostgreSQL database",
    "category": "Backup & Restore",
    "technologyId": "postgresql",
    "flags": [
      {
        "flag": "-F",
        "description": "Output format (p=plain, c=custom, d=directory, t=tar)"
      },
      {
        "flag": "-f",
        "description": "Output file or directory name"
      },
      {
        "flag": "--schema-only",
        "description": "Dump only schema, no data"
      },
      {
        "flag": "--data-only",
        "description": "Dump only data, no schema"
      },
      {
        "flag": "-t",
        "description": "Dump specific table only"
      },
      {
        "flag": "-j",
        "description": "Parallel jobs (directory format -Fd only)"
      },
      {
        "flag": "-n",
        "description": "Dump only the given schema"
      },
      {
        "flag": "-T",
        "description": "Exclude a table"
      },
      {
        "flag": "--no-owner",
        "description": "Don't output ownership commands"
      },
      {
        "flag": "--filter=FILE",
        "description": "Include/exclude objects listed in a file (PostgreSQL 17+)"
      }
    ],
    "examples": [
      {
        "command": "pg_dump -Fc -d mydb -f mydb.dump",
        "description": "Recommended: compressed custom-format backup for pg_restore"
      },
      {
        "command": "pg_dump -Fd -j 4 -d mydb -f mydb_dir",
        "description": "Parallel dump into a directory"
      },
      {
        "command": "pg_dump -h db.example.com -U app -Fc -d mydb -f mydb.dump",
        "description": "Back up a remote database"
      },
      {
        "command": "pg_dump mydb > backup.sql",
        "description": "Dump database to SQL file"
      },
      {
        "command": "pg_dump -Fc mydb > backup.dump",
        "description": "Create custom format backup"
      },
      {
        "command": "pg_dump -t users mydb > users.sql",
        "description": "Dump only users table"
      },
      {
        "command": "pg_dump --schema-only mydb > schema.sql",
        "description": "Dump schema without data"
      }
    ],
    "notes": [
      "Custom format (-Fc) allows selective restore",
      "Use pg_dumpall to backup all databases",
      "Plain SQL dumps (the default) are restored with psql, not pg_restore",
      "Use the pg_dump from the newest PostgreSQL version involved; it can dump older servers but not newer ones",
      "pg_dump doesn't include roles; dump them separately with pg_dumpall --globals-only"
    ],
    "relatedCommands": [
      "pg-restore",
      "pg-dumpall"
    ]
  },
  {
    "id": "pg-restore",
    "name": "pg_restore",
    "description": "Restore a PostgreSQL database from archive",
    "category": "Backup & Restore",
    "technologyId": "postgresql",
    "flags": [
      {
        "flag": "-d",
        "description": "Database to restore into"
      },
      {
        "flag": "-c",
        "description": "Clean (drop) objects before recreating"
      },
      {
        "flag": "-j",
        "description": "Number of parallel jobs"
      },
      {
        "flag": "--no-owner",
        "description": "Skip restoration of object ownership"
      },
      {
        "flag": "-t",
        "description": "Restore specific table only"
      },
      {
        "flag": "--if-exists",
        "description": "With -c, use DROP ... IF EXISTS"
      },
      {
        "flag": "--no-privileges",
        "description": "Skip GRANT/REVOKE"
      },
      {
        "flag": "-l",
        "description": "List the archive's table of contents"
      }
    ],
    "examples": [
      {
        "command": "pg_restore -d mydb backup.dump",
        "description": "Restore from custom format backup"
      },
      {
        "command": "pg_restore -c -d mydb backup.dump",
        "description": "Clean and restore database"
      },
      {
        "command": "pg_restore -j 4 -d mydb backup.dump",
        "description": "Parallel restore with 4 jobs"
      },
      {
        "command": "pg_restore -t users -d mydb backup.dump",
        "description": "Restore only users table"
      },
      {
        "command": "pg_restore -d mydb -j 4 --no-owner --no-privileges mydb.dump",
        "description": "Fast parallel restore into another environment"
      },
      {
        "command": "createdb mydb_copy && pg_restore -d mydb_copy mydb.dump",
        "description": "Restore into a new database"
      },
      {
        "command": "pg_restore -l mydb.dump",
        "description": "List what's inside an archive"
      }
    ],
    "notes": [
      "Only works with non-plain-text dumps",
      "For plain SQL, use psql -f instead",
      "-j works with custom (-Fc) and directory (-Fd) archives",
      "WARNING: -c drops existing objects in the target database before recreating them"
    ],
    "relatedCommands": [
      "pg-dump",
      "psql"
    ]
  },
  {
    "id": "pg-dumpall",
    "name": "pg_dumpall",
    "description": "Backup all PostgreSQL databases",
    "category": "Backup & Restore",
    "technologyId": "postgresql",
    "flags": [
      {
        "flag": "--globals-only",
        "description": "Dump only global objects (roles, tablespaces)"
      },
      {
        "flag": "--roles-only",
        "description": "Dump only roles"
      }
    ],
    "examples": [
      {
        "command": "pg_dumpall > all_databases.sql",
        "description": "Backup all databases"
      },
      {
        "command": "pg_dumpall --globals-only > globals.sql",
        "description": "Backup only roles and tablespaces"
      }
    ],
    "notes": [
      "Output is always plain SQL format",
      "Includes all databases, roles, and tablespaces"
    ],
    "relatedCommands": [
      "pg-dump",
      "pg-restore"
    ]
  },
  {
    "id": "pg-basebackup",
    "name": "pg_basebackup",
    "description": "Take a physical base backup of a whole cluster (for replicas or PITR)",
    "category": "Backup & Restore",
    "technologyId": "postgresql",
    "flags": [
      {
        "flag": "-D",
        "description": "Target directory"
      },
      {
        "flag": "-Ft",
        "description": "Tar format"
      },
      {
        "flag": "-z",
        "description": "Compress tar output"
      },
      {
        "flag": "-X stream",
        "description": "Stream WAL during the backup (default)"
      },
      {
        "flag": "-P",
        "description": "Show progress"
      },
      {
        "flag": "-R",
        "description": "Write replica config (standby.signal + primary_conninfo)"
      },
      {
        "flag": "--incremental=MANIFEST",
        "description": "Incremental backup against a previous backup's manifest (PostgreSQL 17+)"
      }
    ],
    "examples": [
      {
        "command": "pg_basebackup -h primary.example.com -U replicator -D /var/lib/postgresql/data -R -P",
        "description": "Seed a streaming replica"
      },
      {
        "command": "pg_basebackup -D /backups/base -Ft -z -P",
        "description": "Compressed tar backup of the local cluster"
      }
    ],
    "notes": [
      "Copies the entire cluster (all databases); for single databases use pg_dump",
      "Restore incremental backups by merging them with pg_combinebackup (PostgreSQL 17+)"
    ],
    "relatedCommands": [
      "pg-dump",
      "pg-ctl"
    ]
  },
