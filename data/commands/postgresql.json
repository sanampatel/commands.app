    "flags": [
      {
        "flag": "-a",
        "description": "Reindex all databases"
      },
      {
        "flag": "-t",
        "description": "Reindex specific table"
      },
      {
        "flag": "-i",
        "description": "Reindex specific index"
      }
    ],
    "examples": [
      {
        "command": "reindexdb mydb",
        "description": "Reindex all indexes in database"
      },
      {
        "command": "reindexdb -t users mydb",
