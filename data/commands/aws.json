    "category": "Operations",
    "technologyId": "aws",
    "flags": [
      {
        "flag": "--table-name",
        "description": "Table to read"
      },
      {
        "flag": "--key",
        "description": "Primary key in DynamoDB JSON for get-item"
      },
      {
        "flag": "--filter-expression",
        "description": "Filter applied after reading (scan/query)"
      },
      {
        "flag": "--expression-attribute-values",
        "description": "Values referenced in expressions"
      },
      {
        "flag": "--max-items",
        "description": "Limit results returned by the CLI"
      }
    ],
    "examples": [
      {
        "command": "aws dynamodb get-item --table-name Users --key '{\"pk\": {\"S\": \"USER#42\"}}'",
        "description": "Get a single item by key"
      },
      {
        "command": "aws dynamodb query --table-name Orders --key-condition-expression 'pk = :pk' --expression-attribute-values '{\":pk\": {\"S\": \"USER#42\"}}'",
        "description": "Query items by partition key"
      },
      {
        "command": "aws dynamodb scan --table-name Users --max-items 10",
        "description": "Peek at the first items"
      },
      {
        "command": "aws dynamodb scan --table-name Users --select COUNT",
        "description": "Count items (reads the whole table)"
      }
    ],
    "notes": [
      "Scan reads the entire table and consumes read capacity; prefer query on large tables."
    ],
