  {
    "id": "git-commit",
    "name": "git commit",
    "description": "Record changes to the repository",
    "category": "Basic Workflow",
    "technologyId": "git",
    "flags": [
      {
        "flag": "-m 'message'",
        "description": "Commit with inline message"
      },
      {
        "flag": "-a",
        "description": "Automatically stage modified files"
      },
      {
        "flag": "--amend",
        "description": "Replace the last commit (add staged changes and/or edit its message)"
      },
      {
        "flag": "--no-edit",
        "description": "With --amend, keep the existing commit message"
      },
      {
        "flag": "--fixup=<commit>",
        "description": "Create a fixup! commit to be squashed into <commit> by rebase --autosquash"
      },
      {
        "flag": "--no-verify",
        "description": "Skip pre-commit and commit-msg hooks"
      },
      {
        "flag": "-S",
        "description": "GPG/SSH-sign the commit"
      }
    ],
    "examples": [
      {
        "command": "git commit -m 'Add new feature'",
        "description": "Commit staged changes"
      },
      {
        "command": "git commit -am 'Fix bug'",
        "description": "Stage and commit modified files"
      },
      {
        "command": "git commit --amend",
        "description": "Amend last commit"
      },
      {
        "command": "git commit --amend --no-edit",
        "description": "Add staged changes to the last commit without changing its message"
      },
      {
        "command": "git commit --amend -m 'Better message'",
        "description": "Rewrite the last commit message"
      },
      {
        "command": "git commit --fixup=a1b2c3d",
        "description": "Record a fix for an earlier commit"
      },
      {
        "command": "git rebase -i --autosquash main",
        "description": "Squash all fixup! commits into their targets"
      }
    ],
    "notes": [
      "--amend and --fixup + autosquash rewrite history: only do this on commits you haven't pushed, or push afterwards with --force-with-lease",
      "Set rebase.autoSquash=true to make every interactive rebase autosquash by default"
    ],
    "relatedCommands": [
      "git-add",
      "git-push"
    ]
  },
  {
    "id": "git-rm",
    "name": "git rm",
    "description": "Remove files from the working tree and the index",
    "category": "Basic Workflow",
    "technologyId": "git",
    "flags": [
      {
        "flag": "--cached",
        "description": "Untrack the file but keep it on disk"
      },
      {
        "flag": "-r",
        "description": "Remove directories recursively"
      },
      {
        "flag": "-n",
        "description": "Dry run"
      }
    ],
    "examples": [
      {
        "command": "git rm old-file.txt",
        "description": "Delete a file and stage the deletion"
      },
      {
        "command": "git rm --cached .env",
        "description": "Stop tracking a file but keep it locally (then add it to .gitignore)"
      },
      {
        "command": "git rm -r --cached node_modules",
        "description": "Untrack a directory committed by mistake"
      }
    ],
    "notes": [
      "--cached does not remove the file from earlier commits; rotate any leaked secrets"
    ],
    "relatedCommands": [
      "git-mv",
      "git-add",
      "git-status"
    ]
  },
  {
    "id": "git-mv",
    "name": "git mv",
    "description": "Move or rename a tracked file and stage the change",
    "category": "Basic Workflow",
    "technologyId": "git",
    "flags": [
      {
        "flag": "-f",
        "description": "Overwrite the destination if it exists"
      },
      {
        "flag": "-n",
        "description": "Dry run"
      }
    ],
    "examples": [
      {
        "command": "git mv old-name.ts new-name.ts",
        "description": "Rename a file"
      },
      {
        "command": "git mv Readme.md README.md",
        "description": "Change filename case on case-insensitive filesystems (macOS/Windows)"
      },
      {
        "command": "git mv src/utils.ts src/lib/",
        "description": "Move a file into another directory"
      }
    ],
    "notes": [
      "Git detects renames by content, so a plain mv + git add works too; git mv just stages it in one step"
    ],
    "relatedCommands": [
      "git-rm",
      "git-status"
    ]
  },
  {
    "id": "git-push",
    "name": "git push",
    "description": "Update remote repository with local commits",
    "category": "Remote Operations",
    "technologyId": "git",
    "flags": [
      {
        "flag": "-u origin branch",
        "description": "Set upstream branch"
      },
      {
        "flag": "--force",
        "description": "Force push, overwriting remote history (dangerous)"
      },
      {
        "flag": "--tags",
        "description": "Push tags"
      },
      {
        "flag": "--force-with-lease",
        "description": "Force push only if the remote branch is still where you last saw it (safer than --force)"
      },
      {
        "flag": "--delete",
        "description": "Delete a remote branch or tag"
      }
    ],
    "examples": [
      {
        "command": "git push",
        "description": "Push commits to remote"
      },
      {
        "command": "git push -u origin main",
        "description": "Push and set upstream"
      },
      {
        "command": "git push origin --delete branch-name",
        "description": "Delete remote branch"
      },
      {
        "command": "git push --force-with-lease",
        "description": "Safely push a rebased/amended branch"
      },
      {
        "command": "git push origin v1.2.0",
        "description": "Push a single tag"
      }
    ],
    "notes": [
      "Requires write access to remote repository",
      "WARNING: --force can silently discard commits teammates pushed. Prefer --force-with-lease, and never force push shared branches like main",
      "Set push.autoSetupRemote=true so a plain 'git push' sets the upstream on first push"
    ],
    "relatedCommands": [
      "git-pull",
      "git-fetch"
    ]
  },
