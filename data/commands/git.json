  {
    "id": "git-rebase",
    "name": "git rebase",
    "description": "Reapply commits on top of another base tip",
    "category": "Branching",
    "technologyId": "git",
    "flags": [
      {
        "flag": "-i",
        "description": "Interactive rebase"
      },
      {
        "flag": "--autosquash",
        "description": "Automatically squash fixup!/squash! commits during interactive rebase"
      },
      {
        "flag": "--onto <newbase>",
        "description": "Transplant a range of commits onto a different base"
      },
      {
        "flag": "--continue",
        "description": "Continue after resolving conflicts"
      },
      {
        "flag": "--abort",
        "description": "Abort and return to the pre-rebase state"
      },
      {
        "flag": "--update-refs",
        "description": "Also move branches that point at rebased commits (stacked branches)"
      }
    ],
    "examples": [
      {
        "command": "git rebase main",
        "description": "Rebase current branch onto main"
      },
      {
        "command": "git rebase -i HEAD~3",
        "description": "Interactive rebase last 3 commits"
      },
      {
        "command": "git rebase --continue",
        "description": "Continue after fixing conflicts and staging them"
      },
      {
        "command": "git rebase --onto main feature-a feature-b",
        "description": "Move feature-b's own commits from feature-a onto main"
      }
    ],
    "notes": [
      "Don't rebase commits that have been pushed to public repos",
      "Use with caution"
    ],
    "relatedCommands": [
      "git-merge",
      "git-commit",
      "git-reflog"
    ]
  },
