    "category": "Basic Workflow",
    "technologyId": "git",
    "examples": [
      {
        "command": "git add file.txt",
        "description": "Stage specific file"
      },
      {
        "command": "git add .",
        "description": "Stage all changes in current directory"
      },
      {
