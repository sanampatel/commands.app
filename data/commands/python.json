  {
    "id": "python-timeit",
    "name": "python -m timeit",
    "description": "Time small code snippets",
    "category": "Debugging",
    "technologyId": "python",
    "flags": [
      {
        "flag": "-n N",
        "description": "Number of executions per loop"
      },
      {
        "flag": "-r N",
        "description": "Number of repeats (default 5)"
      },
      {
        "flag": "-s STMT",
        "description": "Setup statement run once before timing"
      }
    ],
    "examples": [
      {
        "command": "python -m timeit \"'-'.join(str(n) for n in range(100))\"",
        "description": "Time an expression"
      },
      {
        "command": "python -m timeit -s \"import json; d={'a': 1}\" \"json.dumps(d)\"",
        "description": "Time with setup code excluded"
      }
    ],
    "notes": [
      "Reports the best of several runs; picks the loop count automatically if -n isn't given"
    ],
    "relatedCommands": [
      "python-cprofile"
    ]
  },
