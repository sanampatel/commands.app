[
  {
    "id": "python-pip-install",
    "name": "pip install",
    "description": "Install Python packages",
    "category": "Package Management",
    "technologyId": "python",
    "flags": [
      {
        "flag": "-r requirements.txt",
        "description": "Install from requirements file"
      },
      {
        "flag": "--upgrade",
        "description": "Upgrade package"
      },
      {
        "flag": "--user",
        "description": "Install to user directory"
      },
      {
        "flag": "-e, --editable <path>",
        "description": "Install a local project in editable (development) mode"
      },
      {
        "flag": "-U, --upgrade",
        "description": "Upgrade to the newest available version"
      },
      {
        "flag": "-c <file>",
        "description": "Apply version constraints from a file"
      },
      {
        "flag": "--pre",
        "description": "Include pre-release versions"
      },
      {
        "flag": "--no-cache-dir",
        "description": "Don't use pip's cache (smaller Docker images)"
      }
    ],
    "examples": [
      {
        "command": "pip install requests",
        "description": "Install package"
      },
      {
        "command": "pip install -r requirements.txt",
        "description": "Install from requirements file"
      },
      {
        "command": "pip install --upgrade pip",
        "description": "Upgrade pip itself"
      },
      {
        "command": "pip install -e .",
        "description": "Install the current project in editable mode"
      },
      {
        "command": "pip install -e \".[dev]\"",
        "description": "Editable install with the 'dev' optional dependencies"
      },
      {
        "command": "pip install \"django>=5,<6\"",
        "description": "Install within a version range (quote to protect < and >)"
      },
      {
        "command": "pip install --no-cache-dir -r requirements.txt",
        "description": "Install for a Docker image without keeping the cache"
      }
    ],
    "notes": [
      "Prefer 'python -m pip' so packages go to the interpreter you expect",
      "On many Linux distros and Homebrew Python, installing into the system interpreter fails with 'externally-managed-environment' (PEP 668); use a virtual environment or pipx",
      "--user does nothing inside a virtual environment"
    ],
    "relatedCommands": [
      "python-pip-uninstall",
      "python-module-pip",
      "python-venv",
      "python-pip-freeze"
    ]
  },
