  {
    "id": "python-timeit",
    "name": "python -m timeit",
    "description": "Time small code snippets",
    "category": "Debugging",
    "technologyId": "python",
    "flags": [
      {
        "flag": "-n N",
        "description": "Number of executions per loop"
      },
      {
        "flag": "-r N",
        "description": "Number of repeats (default 5)"
      },
      {
        "flag": "-s STMT",
        "description": "Setup statement run once before timing"
      }
    ],
    "examples": [
      {
        "command": "python -m timeit \"'-'.join(str(n) for n in range(100))\"",
        "description": "Time an expression"
      },
      {
        "command": "python -m timeit -s \"import json; d={'a': 1}\" \"json.dumps(d)\"",
        "description": "Time with setup code excluded"
      }
    ],
    "notes": [
      "Reports the best of several runs; picks the loop count automatically if -n isn't given"
    ],
    "relatedCommands": [
      "python-cprofile"
    ]
  },
  {
    "id": "python-cprofile",
    "name": "python -m cProfile",
    "description": "Profile a script to find where time is spent",
    "category": "Debugging",
    "technologyId": "python",
    "flags": [
      {
        "flag": "-s KEY",
        "description": "Sort output, e.g. cumtime or tottime"
      },
      {
        "flag": "-o FILE",
        "description": "Save stats to a file for later analysis"
      }
    ],
    "examples": [
      {
        "command": "python -m cProfile -s cumtime script.py",
        "description": "Profile and sort by cumulative time"
      },
      {
        "command": "python -m cProfile -o profile.out script.py",
        "description": "Save profile data"
      },
      {
        "command": "python -m pstats profile.out",
        "description": "Browse saved profile data interactively"
      },
      {
        "command": "python -m profiling.tracing -s cumtime script.py",
        "description": "Same profiler under its new name (3.15+)"
      }
    ],
    "notes": [
      "Python 3.15 moved cProfile to profiling.tracing (cProfile stays as an alias); the pure-Python profile module is deprecated for removal in 3.17",
      "For low-overhead profiling of running processes, see python -m profiling.sampling (3.15+)"
    ],
    "relatedCommands": [
      "python-timeit",
      "python-pdb",
      "python-profiling-sampling"
    ]
  },
  {
    "id": "python-profiling-sampling",
    "name": "python -m profiling.sampling",
    "description": "Low-overhead sampling profiler that can run a script or attach to a live process (Python 3.15+)",
    "category": "Debugging",
    "technologyId": "python",
    "flags": [
      {
        "flag": "--flamegraph",
        "description": "Write an interactive HTML flame graph"
      },
      {
        "flag": "-o FILE",
        "description": "Output file"
      },
      {
        "flag": "--mode wall|cpu|gil|exception",
        "description": "What to sample (default wall-clock time)"
      },
      {
        "flag": "-d SECONDS",
        "description": "Sampling duration"
      },
      {
        "flag": "-a",
        "description": "Sample all threads, not just the main thread"
      },
      {
        "flag": "--live",
        "description": "Real-time top-like TUI"
      }
    ],
    "examples": [
      {
        "command": "python -m profiling.sampling run script.py",
        "description": "Profile a script from start to finish"
      },
      {
        "command": "python -m profiling.sampling run --flamegraph -o profile.html script.py",
        "description": "Generate a flame graph"
      },
      {
        "command": "python -m profiling.sampling attach --live 12345",
        "description": "Watch a running process live"
      },
      {
        "command": "python -m profiling.sampling dump 12345",
        "description": "Print the current stack of every thread (useful for hung processes)"
      },
      {
        "command": "python -m profiling.sampling run -m mypackage.module",
        "description": "Profile a module run with -m"
      }
    ],
    "notes": [
      "Attaching to another process may require root on macOS, or a relaxed ptrace_scope / sudo on Linux"
    ],
    "relatedCommands": [
      "python-cprofile",
      "python-pdb"
    ]
  },
