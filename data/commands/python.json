  {
    "id": "python-venv",
    "name": "python -m venv",
    "description": "Create a virtual environment",
    "category": "Environment",
    "technologyId": "python",
    "examples": [
      {
        "command": "python3 -m venv .venv",
        "description": "Create a venv in .venv (common convention)"
      },
      {
        "command": "source .venv/bin/activate",
        "description": "Activate on macOS/Linux (bash/zsh)"
      },
      {
        "command": ".venv\\Scripts\\Activate.ps1",
        "description": "Activate on Windows PowerShell"
      },
      {
        "command": ".venv\\Scripts\\activate.bat",
        "description": "Activate on Windows cmd.exe"
      },
      {
        "command": "deactivate",
        "description": "Leave the virtual environment"
      },
      {
        "command": "python -m venv venv",
        "description": "Create virtual environment"
      },
      {
        "command": "source venv/bin/activate",
        "description": "Activate virtual environment (Linux/Mac)"
      },
      {
        "command": "venv\\Scripts\\activate",
        "description": "Activate virtual environment (Windows)"
      }
    ],
    "notes": [
      "Always use virtual environments for Python projects",
      "fish: source .venv/bin/activate.fish; csh/tcsh: source .venv/bin/activate.csh",
      "PowerShell may block the script; run Set-ExecutionPolicy -Scope CurrentUser RemoteSigned once",
      "You can skip activation and call the venv's interpreter directly: .venv/bin/python (Windows: .venv\\Scripts\\python.exe)",
      "Add .venv/ to .gitignore; don't commit or copy virtual environments between machines"
    ],
    "relatedCommands": [
      "python-pip-install",
      "python-module-pip"
    ]
  },
